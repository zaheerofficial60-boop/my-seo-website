.about-image {
  position: relative;
  width: 100%;
  max-width: 520px;
  margin: 0 auto;
  border-radius: 24px;
  overflow: hidden;
  background: #eef5ff;
  border: 1px solid #d7e5ff;
  box-shadow: 0 20px 50px rgba(20, 70, 140, 0.12);
}

.about-image img {
  display: block;
  width: 100%;
  height: 560px;
  object-fit: cover;
  object-position: center top;
}

.image-badge {
  position: absolute;
  left: 24px;
  bottom: 24px;
  padding: 16px 22px;
  border-radius: 14px;
  background: #08245c;
  color: white;
  box-shadow: 0 10px 30px rgba(0, 30, 80, 0.25);
}

.image-badge strong {
  display: block;
  font-size: 15px;
  margin-bottom: 5px;
}

.image-badge span {
  font-size: 13px;
  opacity: 0.9;
}
